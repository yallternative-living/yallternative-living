# Dev-time only -- never ships to the deployed site.
# no trailing slash: a symlink named node_modules must be ignored too
node_modules

# Secrets. Netlify publishes the whole repository (publish = "."), so a
# committed .env would be downloadable from the live domain. docs/DEVELOPMENT.md
# has always claimed these were ignored; until now they were not.
.env
.env.*
!.env.example

# Deploy-tool local state
.vercel/
.netlify/

# Claude Code harness state: worktrees, transcripts and a second package-lock
.claude/

# OS cruft
.DS_Store

# AI Agent runtime state & logs
.agents/
.Jules/
*.log

# Stray editor/filesystem lock artifacts -- harmless leftovers, not real
# source files, sandbox permissions prevented deleting them outright.
check_tmp.js
assets/data/.fuse_hidden*
assets/data/shop_jsonld.tmp.json
*.tmp
tmp/
# Local render probes and screenshots. Netlify publishes the repository root
# and there is no 404 rule for /scratch/*, so this must never be committed.
scratch/

# Local reports
audit_report.md
scripts/etsy-sync-report.md
*audit-report.md
*audit_report.md
ui_ux_report.md
