# index.html and about.html contain <!--YL:page.key-->...<!--/YL:page.key-->
# HTML comment markers that scripts/build-site-data.js's injectPageCopy()
# matches with an exact-literal regex (see that function's own comment).
# An HTML formatter reflowing whitespace inside/around those comments
# would break the marker match and fail the next build loudly (it throws
# rather than corrupting silently -- see injectPageCopy) -- excluded here
# so that never happens by accident. Safe to format by hand if you're
# careful to leave the YL: comments exactly as-is.
index.html
about.html

