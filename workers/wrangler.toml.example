# Copy to wrangler.toml and fill in. One Worker per [env] keeps secrets separate.
# Docs: https://developers.cloudflare.com/workers/wrangler/configuration/

name = "yallternative-checkout"
main = "checkout.js"
compatibility_date = "2026-01-01"

[vars]
SITE_ORIGIN = "https://yallternativeliving.com"

# Sales tax needs no config: the Worker checks Stripe hourly and enables
# automatic_tax once Tax -> Settings/Registrations are done in the Dashboard.
# This var is only an override -- "true" forces it on without checking,
# "false" is a kill switch. Leave it out unless you need one of those.
# (The Stripe key needs Tax Settings read access for the check to work.)
# STRIPE_TAX_ENABLED = "false"

# Secrets are NOT set here. Set them with:
#   npx wrangler secret put STRIPE_SECRET_KEY
#
# For the form Worker, deploy separately (name = "yallternative-forms",
# main = "submit-form.js") with these vars/secrets:
#   [vars] TO_EMAIL, FROM_EMAIL
#   secrets: RESEND_API_KEY, TURNSTILE_SECRET_KEY
