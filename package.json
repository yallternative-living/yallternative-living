{
  "name": "yallternative-living-site",
  "private": true,
  "version": "1.0.0",
  "description": "Dev-time build tooling for the Y'allternative Living static site. Nothing here ships to the live site -- the deployed site is still 100% static HTML/CSS/JS with zero runtime dependencies. This just powers a few local maintenance scripts.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build-data": "node scripts/build-site-data.js && npm run format",
    "optimize-images": "node scripts/optimize-images.js",
    "build-security-headers": "node scripts/build-security-headers.js",
    "sync-etsy": "node scripts/apply-etsy-snapshot.js",
    "test": "node scripts/qa-check.js",
    "test:integration": "node scripts/puppeteer_tests.js",
    "lint": "eslint scripts assets/js workers netlify",
    "format": "prettier --write \"scripts/**/*.js\" \"assets/js/*.js\"",
    "format:check": "prettier --check \"scripts/**/*.js\" \"assets/js/*.js\""
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "@axe-core/puppeteer": "^4.12.1",
    "axe-core": "^4.12.1",
    "get-pixels": "^3.3.3",
    "html-validator": "^6.0.1",
    "puppeteer": "^25.3.0",
    "resend": "^6.17.2"
  }
}
